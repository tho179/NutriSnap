<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="ring" android:thickness="10dp" android:useLevel="false">
            <solid android:color="#F2F2F2" />
        </shape>
    </item>
    <item>
        <rotate android:fromDegrees="270" android:toDegrees="270">
            <shape android:shape="ring" android:thickness="12dp" android:useLevel="true">
                <solid android:color="#FFA726" />
            </shape>
        </rotate>
    </item>
</layer-list>
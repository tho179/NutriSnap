<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="15dp">

    <androidx.cardview.widget.CardView
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        app:cardCornerRadius="25dp"
        app:cardElevation="10dp"
        android:layout_gravity="center">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp">

            <TextView
                android:id="@+id/tv_dialog_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="Update weight"
                android:textColor="@color/primary_green"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_dialog_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/tv_dialog_title"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="Today, Sep 19"
                android:textColor="#FF5252"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edt_weight_input"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_below="@id/tv_dialog_date"
                android:layout_marginTop="20dp"
                android:layout_marginHorizontal="20dp"
                android:background="@drawable/bg_circle_gray"
                android:gravity="center"
                android:hint="0.0"
                android:inputType="numberDecimal"
                android:paddingHorizontal="15dp"
                android:textColor="@color/black"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/edt_weight_input"
                android:layout_marginTop="30dp"
                android:gravity="center"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_cancel_dialog"
                    android:layout_width="110dp"
                    android:layout_height="45dp"
                    android:layout_marginEnd="15dp"
                    android:background="@drawable/bg_unit_toggle"
                    android:text="Cancel"
                    android:textAllCaps="false"
                    android:textColor="@color/primary_green"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_update_confirm"
                    android:layout_width="110dp"
                    android:layout_height="45dp"
                    android:background="@drawable/bg_button_green"
                    android:text="update"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textStyle="bold" />

            </LinearLayout>
        </RelativeLayout>
    </androidx.cardview.widget.CardView>

    <ImageView
        android:id="@+id/btn_close_dialog"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="top|end"
        android:layout_marginEnd="5dp"
        android:layout_marginTop="5dp"
        android:elevation="11dp"
        android:src="@drawable/ic_close_red"
        android:clickable="true"
        android:focusable="true"/>

</FrameLayout>
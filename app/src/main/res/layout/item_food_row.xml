<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="70dp"
    android:paddingHorizontal="20dp"
    android:background="@color/white">

    <androidx.cardview.widget.CardView
        android:id="@+id/card_food"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:layout_centerVertical="true"
        app:cardCornerRadius="22.5dp"
        app:cardElevation="0dp">
        <ImageView
            android:id="@+id/img_food_icon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/img_salad" />
    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/tv_food_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@id/card_food"
        android:layout_centerVertical="true"
        android:layout_marginStart="15dp"
        android:text="Food Name"
        android:textColor="@color/black"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_food_kcal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_toStartOf="@id/btn_delete_food"
        android:layout_marginEnd="15dp"
        android:text="0 kcal"
        android:textColor="#757575"
        android:textSize="14sp" />

    <ImageView
        android:id="@+id/btn_delete_food"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:src="@drawable/ic_delete"
        app:tint="#FF5252" />
</RelativeLayout>
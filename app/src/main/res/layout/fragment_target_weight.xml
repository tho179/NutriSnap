<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/white"
    android:gravity="center_horizontal">

    <TextView
        android:id="@+id/tv_title_target_weight"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="60dp"
        android:text="@string/target_weight_title"
        android:gravity="center"
        android:textColor="@color/black"
        android:textSize="26sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_target_unit_kg"
            android:layout_width="75dp"
            android:layout_height="45dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_button_green"
            android:gravity="center"
            android:text="kg"
            android:textColor="@color/white"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_target_unit_lb"
            android:layout_width="75dp"
            android:layout_height="45dp"
            android:background="@drawable/bg_unit_toggle"
            android:gravity="center"
            android:text="lb"
            android:textColor="@color/black"
            android:textStyle="bold" />
    </LinearLayout>

    <EditText
        android:id="@+id/et_setup_target_weight"
        android:layout_width="match_parent"
        android:layout_height="85dp"
        android:layout_marginTop="60dp"
        android:background="@drawable/bg_input_selector"
        android:gravity="center"
        android:hint="65"
        android:inputType="numberDecimal"
        android:textColor="@color/black"
        android:textSize="28sp"
        android:textStyle="bold" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F5F7"
    android:orientation="vertical">

    <RelativeLayout
        android:id="@+id/header_notification"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:background="@color/primary_green"
        android:paddingTop="20dp">

        <ImageView
            android:id="@+id/btn_back_notification"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_centerVertical="true"
            android:layout_marginStart="20dp"
            android:padding="4dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Thông báo"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="20dp">

            <!-- Phần cài đặt nhắc nhở -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cài đặt nhắc nhở mới"
                        android:textColor="@color/black"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp"/>

                    <EditText
                        android:id="@+id/edt_reminder_content_main"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Nội dung nhắc nhở..."
                        android:background="@drawable/bg_input_chat"
                        android:padding="12dp"
                        android:textSize="14sp"
                        android:inputType="textCapSentences"
                        android:layout_marginBottom="12dp"
                        android:autofillHints="none"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="16dp">

                        <TextView
                            android:id="@+id/tv_reminder_date_main"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="Chọn ngày"
                            android:padding="10dp"
                            android:drawableStart="@drawable/ic_calendar"
                            android:drawablePadding="8dp"
                            android:background="@drawable/bg_input_chat"
                            android:layout_marginEnd="8dp"
                            android:gravity="center_vertical"
                            android:textSize="13sp"/>

                        <TextView
                            android:id="@+id/tv_reminder_time_main"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="Chọn giờ"
                            android:padding="10dp"
                            android:drawableStart="@drawable/ic_plan_check"
                            android:drawablePadding="8dp"
                            android:background="@drawable/bg_input_chat"
                            android:gravity="center_vertical"
                            android:textSize="13sp"/>
                    </LinearLayout>

                    <Button
                        android:id="@+id/btn_save_reminder_main"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:text="Lên lịch nhắc nhở"
                        android:textAllCaps="false"
                        android:backgroundTint="@color/primary_green"
                        android:textColor="@color/white"
                        android:textStyle="bold"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Lịch sử Cài đặt Hẹn -->
            <LinearLayout
                android:id="@+id/layout_history_reminder_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Lịch sử cài đặt hẹn"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:textStyle="bold"/>
                <ImageView
                    android:id="@+id/iv_history_reminder_arrow"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_arrow_back"
                    android:rotation="-90"/>
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_history_reminders"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:paddingHorizontal="16dp"
                android:nestedScrollingEnabled="false"/>

            <!-- Lịch sử Thông báo Hệ thống -->
            <LinearLayout
                android:id="@+id/layout_history_system_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginTop="8dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Lịch sử thông báo hệ thống"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:textStyle="bold"/>
                <ImageView
                    android:id="@+id/iv_history_system_arrow"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_arrow_back"
                    android:rotation="-90"/>
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_history_system"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:paddingHorizontal="16dp"
                android:nestedScrollingEnabled="false"/>

            <TextView
                android:id="@+id/tv_empty_notifications"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="20dp"
                android:text="Không có dữ liệu lịch sử"
                android:textColor="#9E9E9E"
                android:textSize="14sp"
                android:visibility="gone" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>